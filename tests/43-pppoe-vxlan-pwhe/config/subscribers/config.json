{
  "interfaces": {
    "access": [
      {
        "interface": "acc0",
        "type": "pppoe",
        "vlan-mode": "1:1",
        "outer-vlan-min": 200,
        "outer-vlan-max": 201,
        "inner-vlan-min": 10,
        "inner-vlan-max": 10
      }
    ]
  },
  "sessions": {
    "count": 2
  },
  "pppoe": {
    "reconnect": false,
    "discovery-timeout": 5,
    "discovery-retry": 10,
    "host-uniq": true
  },
  "ppp": {
    "authentication": {
      "username": "user{session-global}",
      "password": "test",
      "timeout": 10,
      "retry": 10
    },
    "lcp": {
      "conf-request-timeout": 5,
      "conf-request-retry": 10,
      "keepalive-retry": 5
    },
    "ipcp": {
      "enable": true
    },
    "ip6cp": {
      "enable": false
    }
  },
  "access-line": {
    "agent-circuit-id": "access-a 0/1/{session-global}:{outer-vlan}.{inner-vlan}",
    "agent-remote-id": "SUB-{session-global}"
  }
}