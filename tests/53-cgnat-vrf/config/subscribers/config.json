{
  "interfaces": {
    "network": [
      {
        "interface": "eth2",
        "address": "10.100.0.2/24",
        "gateway": "10.100.0.1"
      }
    ],
    "access": [
      {
        "interface": "eth1",
        "network-interface": "eth2",
        "type": "ipoe",
        "vlan-mode": "1:1",
        "outer-vlan-min": 200,
        "outer-vlan-max": 200,
        "inner-vlan-min": 2,
        "inner-vlan-max": 4,
        "stream-group-id": 1
      },
      {
        "interface": "eth1",
        "network-interface": "eth2",
        "type": "pppoe",
        "vlan-mode": "1:1",
        "outer-vlan-min": 300,
        "outer-vlan-max": 300,
        "inner-vlan-min": 2,
        "inner-vlan-max": 4,
        "stream-group-id": 1
      }
    ]
  },
  "pppoe": {
    "reconnect": false,
    "discovery-timeout": 5,
    "discovery-retry": 10,
    "host-uniq": true
  },
  "ppp": {
    "lcp": {
      "conf-request-timeout": 5,
      "conf-request-retry": 10,
      "keepalive-retry": 5
    },
    "ipcp": {
      "enable": true
    },
    "ip6cp": {
      "enable": false
    }
  },
  "streams": [
    {
      "name": "CGNAT-UDP",
      "stream-group-id": 1,
      "type": "ipv4",
      "direction": "both",
      "pps": 1,
      "nat": true
    },
    {
      "name": "CGNAT-TCP",
      "stream-group-id": 1,
      "type": "ipv4",
      "direction": "both",
      "pps": 1,
      "nat": true,
      "raw-tcp": true
    }
  ],
  "dhcp": {
    "enable": true
  },
  "dhcpv6": {
    "enable": false
  },
  "ipoe": {
    "ipv6": false
  },
  "sessions": {
    "count": 6,
    "max-outstanding": 6,
    "start-rate": 6,
    "stop-rate": 6
  }
}
